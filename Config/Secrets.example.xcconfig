// Copy to Config/Secrets.xcconfig (gitignored) and fill in. Never commit the copy.
// Your MapTiler key (https://cloud.maptiler.com › API keys).
MAPTILER_KEY = paste_your_maptiler_key_here
// Your Apple team ID, needed to install on an iPhone. Find it in Xcode › Settings › Accounts, or see the README.
DEVELOPMENT_TEAM = 
// Any reverse-domain ID nobody else uses, e.g. com.yourname.frontiermap.
FRONTIER_BUNDLE_ID = com.yourname.frontiermap
